<Window x:Class="FF14Sound.NpcVoicesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NPC 聲音表 · 未配對使用預設聲音" Width="1180" Height="760" MinWidth="850" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="14">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="NPC 聲音表" FontSize="26" FontWeight="Bold"/>
   <TextBlock Text="未找到原聲 ≠ 確認冇 CV。未配對時只用文字及 Voice description 生成，唔用 clone reference。" TextWrapping="Wrap" Margin="0,8"/>
   <WrapPanel>
    <TextBox x:Name="Search" Width="320" ToolTip="搜尋 NPC 名稱、ID、描述或備註" TextChanged="Filter_Changed"/>
    <ComboBox x:Name="Filter" Width="190" SelectionChanged="Filter_Changed"><ComboBoxItem Content="未找到原聲"/><ComboBoxItem Content="全部 NPC"/><ComboBoxItem Content="遊戲遇見過"/><ComboBoxItem Content="手動標記無原聲"/></ComboBox>
    <Button Content="儲存描述 / 標記" Click="Save_Click"/><Button Content="匯出目前篩選 CSV" Click="Export_Click"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock x:Name="Summary" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <DataGrid x:Name="Table" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" MinRowHeight="62" HeadersVisibility="Column" Margin="0,10,0,0">
   <DataGrid.Columns>
    <DataGridTextColumn Header="日文名稱" Binding="{Binding Japanese}" IsReadOnly="True" Width="170"/>
    <DataGridTextColumn Header="英文名稱" Binding="{Binding English}" IsReadOnly="True" Width="160"/>
    <DataGridTextColumn Header="使用 Voice / 配對" Binding="{Binding VoiceMapping}" IsReadOnly="True" Width="210">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="5"/><Setter Property="ToolTip" Value="{Binding MappedReference}"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Voice description（可編輯）" Binding="{Binding VoiceDescription, UpdateSourceTrigger=PropertyChanged}" Width="290">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="5"/></Style></DataGridTextColumn.ElementStyle>
     <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.EditingElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="原聲索引狀態" Binding="{Binding OriginalStatus}" IsReadOnly="True" Width="175"/>
    <DataGridComboBoxColumn x:Name="CvColumn" Header="CV 標記（手動）" SelectedItemBinding="{Binding CvMark, UpdateSourceTrigger=PropertyChanged}" Width="135"/>
    <DataGridTextColumn Header="備註（可編輯）" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
    <DataGridTextColumn Header="描述依據" Binding="{Binding DescriptionBasis}" IsReadOnly="True" Width="250"/>
    <DataGridTextColumn Header="聲線性別" Binding="{Binding VoiceGender}" IsReadOnly="True" Width="90"/>
    <DataGridTextColumn Header="聲線年齡感" Binding="{Binding VoiceAge}" IsReadOnly="True" Width="110"/>
    <DataGridTextColumn Header="性別年齡依據" Binding="{Binding VoiceTraitsBasis}" IsReadOnly="True" Width="300"/>
    <DataGridTextColumn Header="角色身份來源" Binding="{Binding DescriptionSource}" IsReadOnly="True" Width="250"/>
    <DataGridTextColumn Header="德文" Binding="{Binding German}" IsReadOnly="True" Width="160"/>
    <DataGridTextColumn Header="法文" Binding="{Binding French}" IsReadOnly="True" Width="160"/>
    <DataGridTextColumn Header="索引鍵" Binding="{Binding Key}" IsReadOnly="True" Width="130"/>
    <DataGridTextColumn Header="最後遇見" Binding="{Binding LastSeen, StringFormat=yyyy-MM-dd HH:mm}" IsReadOnly="True" Width="155"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
