<Window x:Class="FF14Sound.SpeechCacheWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FF14 Voice · 配音快取" Width="900" Height="660" MinWidth="720" MinHeight="500" Background="#F4F6FA" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="配音快取" FontSize="26" FontWeight="Bold" Foreground="#172540"/>
   <TextBlock Text="按角色管理已生成對白及首句聲線" Foreground="#53627C" Margin="0,6,0,12"/>
   <TextBox x:Name="CacheFolder" IsReadOnly="True" TextWrapping="Wrap"/>
   <TextBlock Text="搜尋 NPC"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" x:Name="Reload" Content="重新整理" Click="Reload_Click"/>
    <TextBox x:Name="Search" ToolTip="搜尋 NPC 名稱" TextChanged="Search_Changed"/>
   </DockPanel>
   <TextBlock x:Name="Summary" Margin="0,0,0,12" Foreground="#334966"/>
  </StackPanel>
  <DataGrid x:Name="Rows" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Rows_Changed" HeadersVisibility="Column" RowHeight="32" GridLinesVisibility="Horizontal" BorderBrush="#D3DDE9">
   <DataGrid.Columns>
    <DataGridTextColumn Header="NPC／角色" Binding="{Binding Speaker}" Width="*" MinWidth="260"/>
    <DataGridTextColumn Header="已配句數" Binding="{Binding Sentences}" Width="100" MinWidth="100"/>
    <DataGridTextColumn Header="首句 REF" Binding="{Binding References}" Width="100" MinWidth="100"/>
    <DataGridTextColumn Header="容量" Binding="{Binding Size}" Width="110" MinWidth="110"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <CheckBox x:Name="ResetReferences" Content="同時重設首句 reference（下次重新定聲）" Margin="0,0,0,8"/>
   <TextBlock Text="預設保留首句聲線，只清對白快取。遊戲原聲庫及自訂 reference 檔案不會刪除。" TextWrapping="Wrap" Foreground="#53627C"/>
   <WrapPanel Margin="0,8,0,0">
    <Button x:Name="ClearSelected" Content="清除所選角色" Click="ClearSelected_Click" IsEnabled="False"/>
    <Button x:Name="ClearAll" Content="清除全部快取" Click="ClearAll_Click"/>
   </WrapPanel>
   <TextBlock x:Name="Status" Text="載入中…" TextWrapping="Wrap" Foreground="#334966"/>
  </StackPanel>
 </Grid>
</Window>
