<Window x:Class="FF14Sound.SubtitleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FF14Sound 字幕" Width="960" Height="230" MinWidth="480" MinHeight="120" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowActivated="False" FontFamily="Segoe UI, Microsoft JhengHei" Foreground="White">
 <Border x:Name="Panel" CornerRadius="10" BorderBrush="#596678" BorderThickness="1" Padding="16,10">
  <Border.ContextMenu><ContextMenu><MenuItem Header="顯示 / 隱藏控制列" Click="Compact_Click"/><MenuItem Header="移到主螢幕下方" Click="Bottom_Click"/><MenuItem Header="關閉字幕" Click="Close_Click"/></ContextMenu></Border.ContextMenu>
  <DockPanel LastChildFill="True">
   <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,8">
    <TextBlock Text="字幕 · 拖動此處移動" Width="205" VerticalAlignment="Center" Foreground="#BCC9DA" Cursor="SizeAll" MouseLeftButtonDown="Drag_MouseDown"/>
     <ComboBox x:Name="DisplayMode" Width="92" FontSize="12" Foreground="Black" Margin="4,0" Padding="3" SelectedValuePath="Tag" SelectionChanged="Options_Changed"><ComboBoxItem Tag="translated" Content="翻譯字幕"/><ComboBoxItem Tag="original" Content="原文字幕"/><ComboBoxItem Tag="both" Content="雙語字幕"/></ComboBox>
     <CheckBox x:Name="Pin" Content="置頂" Foreground="White" VerticalAlignment="Center" Margin="6,0" Checked="Options_Changed" Unchecked="Options_Changed"/>
     <TextBlock Text="字體" VerticalAlignment="Center" Margin="4,0"/>
     <Slider x:Name="TextSize" Minimum="18" Maximum="48" Width="70" VerticalAlignment="Center" ValueChanged="Options_Changed"/>
     <TextBlock Text="底色" VerticalAlignment="Center" Margin="4,0"/>
     <Slider x:Name="Shade" Minimum="0.1" Maximum="1" Width="65" VerticalAlignment="Center" ValueChanged="Options_Changed"/>
     <Button Content="精簡" Click="Compact_Click" Margin="5,0" Padding="6,2" Foreground="Black"/>
     <Button Content="×" Click="Close_Click" Margin="0" Padding="8,2" Foreground="Black" ToolTip="關閉字幕視窗"/>
   </WrapPanel>
   <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SpeakerText" Grid.Column="0" FontSize="17" Foreground="#F0D493" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" MouseLeftButtonDown="Drag_MouseDown" Background="Transparent"/>
    <TextBlock x:Name="PlaybackStatus" Grid.Column="1" FontSize="11" Foreground="#BBC9DB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <Button x:Name="PlayOriginal" Content="▶ 播放原文" Tag="original" Click="Play_Click" FontSize="12" Padding="8,2" Margin="0,0,6,0" Foreground="Black" ToolTip="用原文語言配音目前呢句"/>
     <Button x:Name="PlayTranslated" Content="▶ 播放譯文" Tag="translated" Click="Play_Click" FontSize="12" Padding="8,2" Foreground="Black" ToolTip="用翻譯目標語言配音目前譯文"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="CompactHint" DockPanel.Dock="Bottom" Text="雙擊字幕顯示控制列 · 拖動文字可移動 · 右下角可調大小" FontSize="10" Foreground="#8898AE" HorizontalAlignment="Right" Margin="0,3,0,0"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MouseLeftButtonDown="Drag_MouseDown" Background="Transparent">
     <TextBlock x:Name="OriginalText" Foreground="#BBC9DB" TextWrapping="Wrap" Margin="0,0,0,6"/>
     <TextBlock x:Name="TranslatedText" Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </Border>
</Window>
